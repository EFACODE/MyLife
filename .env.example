# Local development environment variables for My Life.
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically for service configuration, and the
# application reads the `MYLIFE_`-prefixed variables via pydantic-settings.

# --- Postgres (docker compose service) ---
POSTGRES_USER=mylife
POSTGRES_PASSWORD=mylife
POSTGRES_DB=mylife
POSTGRES_PORT=5432

# --- Redis (docker compose service) ---
REDIS_PORT=6379

# --- Application ---
MYLIFE_ENVIRONMENT=local
MYLIFE_DEBUG=true
# Points at the Postgres service above. The application default is SQLite, so
# these overrides only take effect once you copy this file to `.env`.
MYLIFE_DATABASE_URL=postgresql+psycopg://mylife:mylife@localhost:5432/mylife
MYLIFE_REDIS_URL=redis://localhost:6379/0
