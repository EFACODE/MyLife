# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.

# Domain Caddy serves (automatic HTTPS). For local testing without a domain use ":80".
MYLIFE_DOMAIN=mylife.example.com

# --- Postgres ---
POSTGRES_USER=mylife
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=mylife

# --- Application ---
# Point the app at the compose services (psycopg v3 driver).
MYLIFE_DATABASE_URL=postgresql+psycopg://mylife:change-me-to-a-strong-password@postgres:5432/mylife
MYLIFE_REDIS_URL=redis://redis:6379/0
MYLIFE_ENVIRONMENT=production

# Auth signing secret — MUST be stable and secret across restarts/replicas.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MYLIFE_JWT_SECRET=change-me-generate-a-long-random-secret

# Note: MYLIFE_STATIC_DIR and MYLIFE_BLOB_STORE_PATH are set in the compose file
# (in-container paths) — do not override them here.
