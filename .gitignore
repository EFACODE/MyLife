# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checker / lint caches
.mypy_cache/
.ruff_cache/

# Local environment
.env
.env.local
# Production secrets — filled from .env.prod.example, never committed (T11.2)
.env.prod

# Editor / OS
.idea/
.vscode/
.DS_Store

# Databases (local dev)
*.sqlite3
*.db

# Local document blob storage (T6.1)
/var/

# Packaged Shopify theme — a build artifact zipped from storefront/ for
# upload, so the source in storefront/ stays the single point of truth.
/atelier-shopify-theme.zip
