{%- comment -%}
  Open Graph + Twitter card metadata.
  Falls back through page-specific media, then the theme's default share image.
{%- endcomment -%}

{%- liquid
  if page_description
    assign meta_description = page_description
  elsif template.name == 'product' and product.description != blank
    assign meta_description = product.description | strip_html | truncatewords: 40
  elsif template.name == 'collection' and collection.description != blank
    assign meta_description = collection.description | strip_html | truncatewords: 40
  elsif shop.description != blank
    assign meta_description = shop.description
  endif

  assign og_title = page_title
  assign og_type = 'website'
  assign og_image = settings.share_image

  case template.name
    when 'product'
      assign og_type = 'product'
      assign og_title = product.title
      if product.featured_media
        assign og_image = product.featured_media.preview_image
      endif
    when 'collection'
      assign og_title = collection.title
      if collection.featured_image
        assign og_image = collection.featured_image
      endif
    when 'article'
      assign og_type = 'article'
      assign og_title = article.title
      if article.image
        assign og_image = article.image
      endif
  endcase
-%}

{%- if meta_description -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if meta_description -%}
  <meta property="og:description" content="{{ meta_description | escape }}">
{%- endif -%}
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if template.name == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if meta_description -%}
  <meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if settings.seo_twitter_handle != blank -%}
  <meta name="twitter:site" content="{{ settings.seo_twitter_handle }}">
{%- endif -%}

{%- comment -%} Paginated listings should not compete with page one in the index. {%- endcomment -%}
{%- if paginate.previous -%}
  <link rel="prev" href="{{ paginate.previous.url }}">
{%- endif -%}
{%- if paginate.next -%}
  <link rel="next" href="{{ paginate.next.url }}">
{%- endif -%}
