{%- comment -%}
  Single inline icon set — no sprite request, no icon font.

  Usage: {% render 'icon', name: 'cart', size: 20, class: 'header__svg' %}
{%- endcomment -%}

{%- liquid
  assign size = size | default: 20
  assign icon_class = class | default: ''
-%}

{%- case name -%}
  {%- when 'search' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="10.75" cy="10.75" r="6.25"/>
      <path d="M15.4 15.4 20 20"/>
    </svg>

  {%- when 'cart' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 7h14l-1.1 12.1a1.5 1.5 0 0 1-1.5 1.4H7.6a1.5 1.5 0 0 1-1.5-1.4Z"/>
      <path d="M9 7V5.8A3 3 0 0 1 12 3a3 3 0 0 1 3 2.8V7"/>
    </svg>

  {%- when 'heart' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 20s-7.5-4.6-7.5-9.4A4.1 4.1 0 0 1 8.6 6.5c1.5 0 2.7.8 3.4 2 .7-1.2 1.9-2 3.4-2a4.1 4.1 0 0 1 4.1 4.1C19.5 15.4 12 20 12 20Z"/>
    </svg>

  {%- when 'user' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.5" r="3.75"/>
      <path d="M4.75 20.25a7.25 7.25 0 0 1 14.5 0"/>
    </svg>

  {%- when 'menu' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 8h16M4 16h16"/>
    </svg>

  {%- when 'close' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6 6 18"/>
    </svg>

  {%- when 'caret' -%}
    <svg class="icon-caret {{ icon_class }}" width="10" height="10" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
      <path d="M0 0l5 5 5-5H0z"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 12h15"/>
      <path d="M13.5 6.5 20 12l-6.5 5.5"/>
    </svg>

  {%- when 'arrow-down' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 4v15"/>
      <path d="M6.5 13.5 12 20l5.5-6.5"/>
    </svg>

  {%- when 'plus' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 5v14M5 12h14"/>
    </svg>

  {%- when 'minus' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 12h14"/>
    </svg>

  {%- when 'star' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m12 4 2.4 5.1 5.6.7-4.1 3.9 1 5.6-4.9-2.8-4.9 2.8 1-5.6L4 9.8l5.6-.7L12 4Z" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'eye' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M2.75 12S6 6.5 12 6.5 21.25 12 21.25 12 18 17.5 12 17.5 2.75 12 2.75 12Z"/>
      <circle cx="12" cy="12" r="2.75"/>
    </svg>

  {%- when 'filter' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 7h16M7 12h10M10 17h4"/>
    </svg>

  {%- when 'truck' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M2.75 6.75h10.5v9.5H2.75z"/>
      <path d="M13.25 10.25h4l3 3v3h-7z"/>
      <circle cx="7" cy="18.5" r="1.75"/>
      <circle cx="17" cy="18.5" r="1.75"/>
    </svg>

  {%- when 'return' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.75 9.5A7.25 7.25 0 1 1 5 15"/>
      <path d="M4.5 4.75v4.75h4.75"/>
    </svg>

  {%- when 'shield' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.5 19 6v6c0 4.3-3 7.4-7 8.5-4-1.1-7-4.2-7-8.5V6l7-2.5Z"/>
      <path d="m9.25 12 2 2 3.5-3.75"/>
    </svg>

  {%- when 'leaf' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 19c0-7 4.5-12 14-12 0 8.5-5 12-9.5 12A4.5 4.5 0 0 1 5 19Z"/>
      <path d="M9 15c2.5-2.5 5-4 8-5"/>
    </svg>

  {%- when 'gift' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 9.5h16V20H4z"/>
      <path d="M4 9.5h16M12 9.5V20"/>
      <path d="M12 9.5S10.5 4 8 4a2 2 0 0 0 0 5.5M12 9.5S13.5 4 16 4a2 2 0 0 1 0 5.5"/>
    </svg>

  {%- when 'sparkle' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.5v5M12 15.5v5M4.5 12h5M14.5 12h5"/>
    </svg>

  {%- when 'instagram' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="16" height="16" rx="4.5"/>
      <circle cx="12" cy="12" r="3.5"/>
      <circle cx="16.75" cy="7.25" r="0.85" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'pinterest' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M10.5 20l2-7"/>
      <path d="M9.5 11.5c0-1.9 1.4-3.4 3.3-3.4 1.7 0 2.9 1.1 2.9 2.8 0 2.1-1.2 3.7-2.8 3.7-.9 0-1.5-.6-1.3-1.4"/>
    </svg>

  {%- when 'facebook' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M14.75 4.5h-1.5a3 3 0 0 0-3 3v2.25H8v3h2.25v6.75h3v-6.75h2.25l.5-3h-2.75V8a.75.75 0 0 1 .75-.75h1.5Z"/>
    </svg>

  {%- when 'tiktok' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M14 4v9.75a3.25 3.25 0 1 1-3.25-3.25"/>
      <path d="M14 4c.4 2.2 1.9 3.6 4.25 3.85"/>
    </svg>

  {%- when 'youtube' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3" y="6.5" width="18" height="11" rx="3.5"/>
      <path d="m10.75 10 3.75 2-3.75 2z" fill="currentColor" stroke="none"/>
    </svg>

  {%- when 'share' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.75v10"/>
      <path d="M8.5 7.25 12 3.75l3.5 3.5"/>
      <path d="M5.5 13v6.25h13V13"/>
    </svg>

  {%- when 'check' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m5 12.5 4.5 4.5L19 7"/>
    </svg>

  {%- when 'zoom' -%}
    <svg class="icon {{ icon_class }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="10.75" cy="10.75" r="6.25"/>
      <path d="M15.4 15.4 20 20M8.5 10.75h4.5M10.75 8.5v4.5"/>
    </svg>
{%- endcase -%}
