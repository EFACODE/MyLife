{%- comment -%}
  Quick view shell. Content is fetched on demand from a product's
  `quick-view` alternate template, so nothing is loaded until it is asked for.
{%- endcomment -%}

<quick-view-modal id="QuickView" class="quick-view" aria-hidden="true">
  <div class="overlay-backdrop" data-overlay-backdrop></div>

  <div
    class="quick-view__dialog"
    data-overlay-panel
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'products.product.quick_view' | t }}"
    tabindex="-1"
  >
    <button
      type="button"
      class="quick-view__close"
      data-overlay-close
      aria-label="{{ 'general.accessibility.close' | t }}"
    >
      {% render 'icon', name: 'close', size: 18 %}
    </button>

    <div class="quick-view__skeleton" data-quick-view-skeleton>
      <span class="spinner"></span>
      <span class="visually-hidden">{{ 'general.accessibility.loading' | t }}</span>
    </div>

    <div data-quick-view-body></div>
  </div>
</quick-view-modal>
