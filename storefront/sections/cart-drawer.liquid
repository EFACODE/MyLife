{%- comment -%}
  Slide-out cart. This is a section so the Section Rendering API can refresh
  it after every add, change or remove without a page load.
{%- endcomment -%}

<cart-drawer id="CartDrawer" aria-hidden="true">
  <div class="overlay-backdrop" data-overlay-backdrop></div>

  <div
    class="drawer drawer--right"
    data-overlay-panel
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'cart.general.heading' | t }}"
    tabindex="-1"
  >
    <header class="drawer__header">
      <h2 class="drawer__title">
        {{ 'cart.general.heading' | t }}
        <span class="drawer__count">{{ 'cart.general.item_count' | t: count: cart.item_count }}</span>
      </h2>
      <button
        type="button"
        class="drawer__close"
        data-overlay-close
        aria-label="{{ 'general.accessibility.close' | t }}"
      >
        {% render 'icon', name: 'close', size: 20 %}
      </button>
    </header>

    {%- comment -%}
      Everything inside this wrapper is replaced on each cart mutation.
      The drawer shell above it keeps its open state and focus trap.
    {%- endcomment -%}
    <div style="display: contents;" data-cart-section="{{ section.id }}">
      {%- if cart.item_count == 0 -%}
        <div class="drawer__body">
          <div class="drawer__empty">
            {% render 'icon', name: 'cart', size: 26 %}
            <p class="text-body">{{ 'cart.general.empty' | t }}</p>
            <a class="button button--primary" href="{{ routes.all_products_collection_url }}">
              {{ 'cart.general.empty_cta' | t }}
            </a>
          </div>
        </div>
      {%- else -%}
        <div class="drawer__body">
          {% render 'shipping-bar' %}

          <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form" novalidate>
            <cart-items class="contents">
              {%- for item in cart.items -%}
                {% render 'cart-item', item: item %}
              {%- endfor -%}
            </cart-items>
          </form>

          {%- if settings.cart_upsell -%}
            {% render 'cart-upsell' %}
          {%- endif -%}
        </div>

        <div class="drawer__footer">
          {% render 'cart-summary', form_id: 'cart-drawer-form', show_view_cart: true %}
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
