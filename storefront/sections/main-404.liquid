<section class="section">
  <div class="page-width">
    <div class="empty-state" data-reveal>
      <span class="eyebrow">404</span>
      <h1 class="h1">{{ 'templates.404.title' | t }}</h1>
      <p class="text-lead" style="text-align: center;">{{ 'templates.404.subtext' | t }}</p>

      <div class="cluster" style="justify-content: center;">
        <a class="button button--primary" href="{{ routes.root_url }}">
          {{ 'general.back_to_home' | t }}
        </a>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "tag": "div",
  "class": "main-404-section",
  "settings": []
}
{% endschema %}
