<section class="section section--tight">
  <div class="page-width" style="max-width: 460px;">
    <div class="stack" style="--stack-gap: 22px;" data-reveal>
      <h1 class="h2">{{ 'customer.login.create_account' | t }}</h1>

      {%- form 'create_customer', novalidate: 'novalidate' -%}
        <div class="stack" style="--stack-gap: 12px;">
          {%- if form.errors -%}
            <p class="form__message form__message--error" role="status">
              {{ form.errors.messages.form }}
            </p>
          {%- endif -%}

          <label class="field field--floating">
            <input class="field__input" type="text" name="customer[first_name]" placeholder=" " autocomplete="given-name">
            <span class="field__label">{{ 'templates.contact.form.name' | t }}</span>
          </label>

          <label class="field field--floating">
            <input class="field__input" type="text" name="customer[last_name]" placeholder=" " autocomplete="family-name">
            <span class="field__label">Last name</span>
          </label>

          <label class="field field--floating">
            <input class="field__input" type="email" name="customer[email]" placeholder=" " autocomplete="email" required>
            <span class="field__label">{{ 'customer.login.email' | t }}</span>
          </label>

          <label class="field field--floating">
            <input class="field__input" type="password" name="customer[password]" placeholder=" " autocomplete="new-password" required>
            <span class="field__label">{{ 'customer.login.password' | t }}</span>
          </label>

          <button type="submit" class="button button--primary button--full">
            {{ 'customer.login.create_account' | t }}
          </button>

          <a class="link link--reveal" href="{{ routes.account_login_url }}" style="align-self: center;">
            {{ 'customer.login.sign_in' | t }}
          </a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
