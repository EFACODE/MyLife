{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "header": {
          "type": "header",
          "settings": {
            "show_vendor": true,
            "low_stock_threshold": 5
          }
        },
        "variant-picker": {
          "type": "variant_picker",
          "settings": {
            "update_url": true
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "truncate": true
          }
        },
        "buy-buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity": true,
            "show_dynamic_checkout": true
          }
        },
        "delivery": {
          "type": "delivery",
          "settings": {}
        },
        "accordion-details": {
          "type": "accordion",
          "settings": {
            "heading": "Details & materials",
            "content": "<p>Solid oak with a natural oil finish. Dimensions and care instructions are listed on the product specification sheet.</p>"
          }
        },
        "accordion-delivery": {
          "type": "accordion",
          "settings": {
            "heading": "Delivery & returns",
            "content": "<p>Standard delivery in 3–5 working days. Returns accepted within 30 days in original packaging.</p>"
          }
        },
        "trust-badges": {
          "type": "trust_badges",
          "settings": {
            "titles": "Secure checkout,Sustainably made,30-day returns,Made to last",
            "texts": "Encrypted payment,FSC-certified wood,No questions asked,Repairable design",
            "icons": "shield,leaf,return,check"
          }
        },
        "share": {
          "type": "share",
          "settings": {}
        }
      },
      "block_order": [
        "header",
        "variant-picker",
        "description",
        "buy-buttons",
        "delivery",
        "accordion-details",
        "accordion-delivery",
        "trust-badges",
        "share"
      ],
      "settings": {
        "gallery_layout": "stacked",
        "enable_zoom": true,
        "sticky_buy": true
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4,
        "columns_desktop": 4,
        "padding_top": 64,
        "padding_bottom": 40
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_to_show": 4,
        "columns_desktop": 4,
        "padding_top": 40,
        "padding_bottom": 96
      }
    }
  },
  "order": ["main", "related-products", "recently-viewed"]
}
